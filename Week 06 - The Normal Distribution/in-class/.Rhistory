x <- 1:4
pmf <- c(0.1, 0.3, 0.4, 0.2) # Creates a column, i.e., a vector.
mean_value <- sum(x * pmf)
# x   = [1, 2, 3, 4]
# pmf = [0.1, 0.3, 0.4, 0.2]
# x * pmf = [0.1, 0.6, 1.2, 0.8]
# sum(x * pmf) = 0.1 + 0.6 + 0.4 + 0.8 = 2.7
print(mean_value)
var_x <- mean_sq_value - mean_value^2
print(var_x)
y <- c(-1, 0, 2, 5)
pmf <- c(0.20, 0.15, 0.45, 0.20)
var_y <- sum(y^2 * pmf)
sd_y <- sum(var_y)
print(paste(var_y, sd_y))
y <- c(-1, 0, 2, 5)
pmf <- c(0.20, 0.15, 0.45, 0.20)
var_y <- sum(y^2 * pmf)
sd_y <- sqrt(var_y)
print(paste(var_y, sd_y))
y <- c(-1, 0, 2, 5)
pmf <- c(0.20, 0.15, 0.45, 0.20)
var_y <- sum(y^2 * pmf)
sd_y <- sqrt(var_y)
print(paste('Variance:', var_y, 'Standard Deviation:', sd_y))
y <- c(-1, 0, 2, 5)
pmf <- c(0.20, 0.15, 0.45, 0.20)
var_y <- sum(y^2 * pmf) - (sum(y * pmf)) ^ 2
sd_y <- sqrt(var_y)
print(paste('Variance:', var_y, 'Standard Deviation:', sd_y))
z <- 0:3
pmf <- c(0.40, 0.35, 0.20, 0.05)
mv <- sum(z * pmf)
varz <- sum(z^2 * pmf) - (sum(z * pmf))^2
sdz <- sqrt(varz)
print(paste('Variance:', varz, 'Standard Deviation:', sdz))
z <- 0:3
pmf <- c(0.40, 0.35, 0.20, 0.05)
mv <- sum(z * pmf)
varz <- sum(z^2 * pmf) - (sum(z * pmf))^2
sdz <- sqrt(varz)
print(paste('Mean:', mv, 'Variance:', varz, 'Standard Deviation:', sdz))
x <- c(0.30, 0.45, 0.25)
y <- c(0.40, 0.60)
xy <- x %*% y
x <- c(0.30, 0.45, 0.25)
y <- c(0.40, 0.60)
xy <- x %*% t(y)
print(xy)
x <- c(0.30, 0.45, 0.25)
y <- c(0.40, 0.60)
xy <- y %*% t(x)
print(xy)
